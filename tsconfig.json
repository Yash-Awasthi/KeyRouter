{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": [],
    "noImplicitAny": false
  },
  "include": [
    "worker.js",
    "src/**/*.js",
    "types/**/*.d.ts"
  ],
  // The tests use node:test and node:assert, which need @types/node; the shipped code must not depend on it.
  "exclude": [
    "worker.test.js",
    "test/**/*.test.*"
  ]
}
